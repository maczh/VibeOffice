{
  "name": "@vibeoffice/workspace",
  "private": true,
  "workspaces": [
    "commonx",
    "wordx",
    "excelx",
    "pptx",
    "suite"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:apps": "npm run build && npm run build:app --workspaces --if-present",
    "dev": "npm run dev:suite",
    "dev:suite": "npm run build && npm run dev --workspace=@vibeoffice/suite",
    "dev:host": "vite --config tests/vite/host.vite.config.ts",
    "typecheck": "tsc --build tsconfig.json",
    "test:workspace": "node --test tests/vite/workspace-packages.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
