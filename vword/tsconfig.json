{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@voffice/shared": [
        "../voffice-shared/src/index.ts"
      ],
      "@voffice/shared/*": [
        "../voffice-shared/src/*"
      ],
      "@voffice/shared/styles": [
        "../voffice-shared/src/styles/index.css"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "dev/**/*.ts",
    "dev/**/*.vue",
    "../voffice-shared/src/**/*.ts",
    "../voffice-shared/src/**/*.vue"
  ]
}
