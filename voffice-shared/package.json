{
  "name": "@voffice/shared",
  "version": "1.0.0",
  "description": "VibeOffice Vue shared core: ZIP/XML/OPC, online file connectors (WebDAV, S3, HTTP POST), Office-2003-style UI components and looks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "module": "./dist/index.js"
}
